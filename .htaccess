# Enable Rewrite Engine
RewriteEngine On

# Force HTTPS (Optional - Uncomment if you want to enforce HTTPS)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirect old PHP pages to new site URLs

# Home Page
RewriteRule ^index\.php$ https://raj-new.netlify.app/ [R=301,L]
RewriteRule ^best-hospital-in-ranchi\.php$ https://raj-new.netlify.app/ [R=301,L]

# General Pages
RewriteRule ^about\.php$ https://raj-new.netlify.app/about [R=301,L]
RewriteRule ^contact\.php$ https://raj-new.netlify.app/contact [R=301,L]
RewriteRule ^find-a-doctor\.php$ https://raj-new.netlify.app/doctors [R=301,L]
RewriteRule ^careers\.php$ https://raj-new.netlify.app/careers [R=301,L]

# Redirect old specialty PHP pages to new specialty URLs

# Aesthetic & Reconstructive Surgery
RewriteRule ^aesthetic-&-reconstructive-surgery\.php$ https://raj-new.netlify.app/specialties/aesthetic-and-reconstructive-surgery [R=301,L]

# Cardiology
RewriteRule ^cardiologist-and-heart-specialist-ranchi\.php$ https://raj-new.netlify.app/specialties/cardiology [R=301,L]

# Critical Care
RewriteRule ^critical-care\.php$ https://raj-new.netlify.app/specialties/critical-care [R=301,L]

# Dental
RewriteRule ^dental-surgeon-ranchi\.php$ https://raj-new.netlify.app/specialties/dental [R=301,L]

# Dermatology
RewriteRule ^dermatologist-ranchi\.php$ https://raj-new.netlify.app/specialties/dermatology [R=301,L]

# Emergency
RewriteRule ^emergency-medicine\.php$ https://raj-new.netlify.app/specialties/emergency [R=301,L]

# ENT
RewriteRule ^ent-specialist\.php$ https://raj-new.netlify.app/specialties/ent [R=301,L]

# Eye Care
RewriteRule ^eye-hospital-ranchi\.php$ https://raj-new.netlify.app/specialties/eye-care [R=301,L]

# Gastroenterology
RewriteRule ^gastroenterology-ranchi\.php$ https://raj-new.netlify.app/specialties/gastroenterology [R=301,L]

# General & Laparoscopic Surgery
RewriteRule ^general-and-laparoscopic-surgery-ranchi\.php$ https://raj-new.netlify.app/specialties/minimal-access-surgery [R=301,L]

# Internal Medicine
RewriteRule ^internal-medicine\.php$ https://raj-new.netlify.app/specialties/internal-medicine [R=301,L]

# Nephrology
RewriteRule ^nephrologist-ranchi\.php$ https://raj-new.netlify.app/specialties/nephrology [R=301,L]

# Neurology
RewriteRule ^neurologist-ranchi\.php$ https://raj-new.netlify.app/specialties/neurology [R=301,L]

# Obstetrics & Gynaecology (Maternity)
RewriteRule ^maternity-and-gynecologist-ranchi\.php$ https://raj-new.netlify.app/specialties/obstetrics-and-gynaecology [R=301,L]

# Oral & Maxillofacial Surgery
RewriteRule ^oral-&-maxillofacial-surgery\.php$ https://raj-new.netlify.app/specialties/oral-and-maxillofacial-surgery [R=301,L]

# Oncology (Cancer Care)
RewriteRule ^oncologist-and-cancer-specialist-ranchi\.php$ https://raj-new.netlify.app/specialties/oncology-cancer-care [R=301,L]

# Orthopaedics & Joint Replacement
RewriteRule ^orthopedic-and-joint-replacement-surgery-ranchi\.php$ https://raj-new.netlify.app/specialties/orthopaedics-and-joint-replacement [R=301,L]

# Pediatrics
RewriteRule ^pediatrician-specialists-ranchi\.php$ https://raj-new.netlify.app/specialties/pediatrics-and-neonatology [R=301,L]

# Physiotherapy
RewriteRule ^physiotherapist-ranchi\.php$ https://raj-new.netlify.app/specialties/physiotherapy-and-rehabilitation [R=301,L]

# Pulmonology
RewriteRule ^pulmonologist-ranchi\.php$ https://raj-new.netlify.app/specialties/pulmonology [R=301,L]

# Urology
RewriteRule ^urology-ranchi\.php$ https://raj-new.netlify.app/specialties/urology [R=301,L]

# Handle React Router (BrowserRouter) - This must be AFTER all specific redirects
# If the requested file or directory doesn't exist, serve index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# Prevent directory browsing
Options -Indexes

# Set default index files
DirectoryIndex index.html index.php

# Set 404 error page (Optional)
# ErrorDocument 404 /404.html

# Set 500 error page (Optional)
# ErrorDocument 500 /500.html

# Enable GZIP Compression (Optional - for better performance)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/atom_xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Browser Caching (Optional - for better performance)
<IfModule mod_expires.c>
  ExpiresActive On
  # Images
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  # CSS and JavaScript
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  # Others
  ExpiresByType application/pdf "access plus 1 month"
  ExpiresByType application/x-shockwave-flash "access plus 1 month"
</IfModule>

# Security Headers (Optional - for better security)
<IfModule mod_headers.c>
  # Prevent clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"
  # Prevent MIME type sniffing
  Header always set X-Content-Type-Options "nosniff"
  # Enable XSS protection
  Header always set X-XSS-Protection "1; mode=block"
  # Referrer Policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
